<?xml version="1.0" encoding="UTF-8"?>
<definition:ConnectorDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:definition="http://www.bonitasoft.org/ns/connector/definition/6.1">
  <id>${mistral-ocr-process-batch.def.id}</id>
  <version>${mistral-ocr-process-batch.def.version}</version>
  <icon>mistral-ocr.png</icon>
  <category icon="mistral-ocr.png" id="Mistral OCR"/>

  <!-- Connection inputs -->
  <input name="apiKey" type="java.lang.String" mandatory="true"/>
  <input name="baseUrl" type="java.lang.String" mandatory="false" defaultValue="https://api.mistral.ai/v1"/>
  <input name="model" type="java.lang.String" mandatory="false" defaultValue="mistral-ocr-latest"/>
  <input name="connectTimeout" type="java.lang.Integer" mandatory="false" defaultValue="30000"/>
  <input name="readTimeout" type="java.lang.Integer" mandatory="false" defaultValue="300000"/>

  <!-- Document inputs -->
  <input name="documentBase64" type="java.lang.String" mandatory="false"/>
  <input name="imageUrls" type="java.lang.String" mandatory="false"/>
  <input name="mimeType" type="java.lang.String" mandatory="false" defaultValue="application/pdf"/>

  <!-- Operation-specific inputs -->
  <input name="startPage" type="java.lang.Integer" mandatory="false"/>
  <input name="endPage" type="java.lang.Integer" mandatory="false"/>

  <!-- Outputs -->
  <output name="fullText" type="java.lang.String"/>
  <output name="pages" type="java.util.List"/>
  <output name="pagesMap" type="java.util.Map"/>
  <output name="pageCount" type="java.lang.Integer"/>
  <output name="totalWordCount" type="java.lang.Integer"/>
  <output name="pagesProcessed" type="java.lang.Integer"/>
  <output name="processingTimeMs" type="java.lang.Long"/>
  <output name="success" type="java.lang.Boolean"/>
  <output name="errorMessage" type="java.lang.String"/>

  <!-- UI Pages -->
  <page id="connectionPage">
    <widget xsi:type="definition:Password" id="apiKeyWidget" inputName="apiKey"/>
    <widget xsi:type="definition:Text" id="baseUrlWidget" inputName="baseUrl"/>
    <widget xsi:type="definition:Text" id="modelWidget" inputName="model"/>
    <widget xsi:type="definition:Text" id="connectTimeoutWidget" inputName="connectTimeout"/>
    <widget xsi:type="definition:Text" id="readTimeoutWidget" inputName="readTimeout"/>
  </page>
  <page id="operationPage">
    <widget xsi:type="definition:TextArea" id="documentBase64Widget" inputName="documentBase64"/>
    <widget xsi:type="definition:Text" id="imageUrlsWidget" inputName="imageUrls"/>
    <widget xsi:type="definition:Text" id="mimeTypeWidget" inputName="mimeType"/>
    <widget xsi:type="definition:Text" id="startPageWidget" inputName="startPage"/>
    <widget xsi:type="definition:Text" id="endPageWidget" inputName="endPage"/>
  </page>
</definition:ConnectorDefinition>
